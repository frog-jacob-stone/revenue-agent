# Production deployment values. Copy to .env.production and fill in.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# .env.production is gitignored and must stay that way. It is read ONLY by the
# scripts in scripts/, which copy these values to Azure and Netlify at deploy
# time. No application code reads this file — the app reads app/.env locally, and
# real environment variables in production.
#
# This is NOT your local development config. Local values live in app/.env and
# ui/.env, each next to the code that reads it; see README.md. This file is at
# the repo root because it spans all three deploy targets — Supabase, Azure, and
# the Netlify build — so it belongs to no single directory. Do not move it into
# ui/: Vite auto-loads a file named .env.production during a production build.
#
# Values are grouped by who consumes them. Adding a key here is enough for
# scripts/deploy-api.sh to pick it up, unless it matches one of the exclusions
# documented in scripts/_load_env.sh.
#
# QUOTING: this file is sourced by bash. A value containing a space, `$`, `!`,
# `&`, or `#` must be wrapped in SINGLE quotes or the load fails with a
# confusing "command not found". Single, not double — double quotes still
# interpolate `$`. Supabase generates passwords with special characters, so the
# fields most likely to need it already have the quotes in place; fill in
# between them.

# --- Deploy targets: read by the scripts, never sent to the container ---------

SUPABASE_PROJECT_REF=
# Your Supabase database password, set when the project was created.
SUPABASE_DB_PASSWORD=''
AZURE_RESOURCE_GROUP=
AZURE_CONTAINERAPP_NAME=revenue-agents-api

# --- API: pushed to the Container App as environment variables ---------------

# Must be exactly "production". Anything else silently disables the startup
# config guard in app/config.py.
ENV=production
LOG_LEVEL=INFO

# Supabase Session pooler string (port 5432 on a pooler host) — NOT the
# transaction pooler on 6543. See DEPLOY.md for why.
DATABASE_URL=''
SUPABASE_URL=

# Comma-separated, https only, no trailing slash. Must match the Netlify origin
# exactly or every browser request is CORS-blocked.
ALLOWED_ORIGINS=

OPENAI_API_KEY=''

HARVEST_TOKEN=''
HARVEST_ACCOUNT_ID=
# Harvest rejects requests without a contact email in the User-Agent.
HARVEST_USER_AGENT_CONTACT=
# Optional. Unset renders invoice screens without links back to Harvest.
HARVEST_BASE_URI=

# Optional. Unset means the revenue-ops agent's get_revenue_data tool fails.
AIRTABLE_API_KEY=''
AIRTABLE_BASE_ID=
AIRTABLE_CLIENTS_TABLE_ID=
AIRTABLE_PROJECTS_TABLE_ID=
AIRTABLE_REVENUE_TABLE_ID=

FORECAST_ACCOUNT_ID=

# --- UI: inlined into the bundle at build time, never sent to the container ---

VITE_API_URL=
VITE_SUPABASE_URL=
# The anon/publishable key. Safe to ship in a bundle; RLS protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=''
