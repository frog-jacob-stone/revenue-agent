# Backend configuration. Copy to app/.env and fill in.
#
# This file is the ONLY env source the app reads (docker-compose points
# `env_file` here; there is no root-level .env). Note that Settings uses
# `extra="ignore"`, so a MISSPELLED KEY IS SILENTLY IGNORED — no error, no
# warning, just a default. Check spelling against app/config.py.
#
# Not here on purpose: default invoice notes. They are copy a human edits, so
# they live in the database (migration 0029) and are editable at
# Settings → Billing. See app/services/billing/settings_store.py.

OPENAI_API_KEY=
SUPABASE_URL=http://host.docker.internal:54321
# Only used by the pytest suite, which signs in as the test user below to get a
# real JWT. No app code path reads it.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_CLIENTS_TABLE_ID=
AIRTABLE_PROJECTS_TABLE_ID=
AIRTABLE_REVENUE_TABLE_ID=

# Harvest
HARVEST_TOKEN=
HARVEST_ACCOUNT_ID=
# Harvest requires a contact email in the User-Agent on every request.
HARVEST_USER_AGENT_CONTACT=
# Your Harvest web address, used to link out to invoices this system created.
# No API exposes it. Left blank, the UI shows no link rather than a wrong one.
HARVEST_BASE_URI=

# Billing / invoicing — nothing to set here. The tuning values are constants in
# the modules that read them, since they are the same in every environment:
#
#   USE_ROUNDED_HOURS        app/services/billing/rates.py
#   STRAGGLER_LOOKBACK_DAYS  app/services/billing/estimator.py
#   UNMAPPED_LOOKBACK_DAYS   app/services/billing/reconcile.py
#   VARIANCE_PCT_THRESHOLD   app/services/billing/planner.py
#
# Default invoice notes are in the `billing_settings` table (migration 0029),
# editable at Settings → Billing.

# Forecast (uses same bearer token as Harvest)
FORECAST_ACCOUNT_ID=

# Test user — created manually in Supabase Studio (Authentication → Add User).
# The pytest suite signs in as this user to get a real JWT for API calls.
# Never used in any code path outside tests.
TEST_USER_EMAIL=test-user@test.com
TEST_USER_PASSWORD=TestPassword123!
