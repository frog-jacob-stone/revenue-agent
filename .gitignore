# Environment
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
# .env.production holds live production credentials and is covered by `.env.*`
# above. Only its template is tracked — the negation is required because
# `!.env.example` does not match `.env.production.example`.
!.env.production.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.eggs/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Ruff / mypy
.ruff_cache/
.mypy_cache/

# Docker
*.log
docker-compose.override.yml

# macOS
.DS_Store

# IDEs
.idea/
.vscode/
*.swp

# Other
.agent/*
.claude/*